# QUICK 4AI Provider Credentials
# ==============================================================

# Google Gemini API Key (Required for Gemini 3.8 Flash analysis)
# Injected automatically in AI Studio from Secrets panel
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI API Key (Required for GPT-4o analysis and critique)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Perplexity API Key (Required for Sonar real-time web grounding and citation checks)
PERPLEXITY_API_KEY="YOUR_PERPLEXITY_API_KEY"

# Anthropic API Key (Required for Claude 3.5 Sonnet final synthesis)
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
